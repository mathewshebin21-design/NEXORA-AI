# Runtime role: must NOT have BYPASSRLS
NEXORA_DATABASE_URL=postgresql+psycopg://nexora_app:CHANGE_ME@localhost:5432/nexora
# Owner role: runs migrations only
NEXORA_OWNER_DATABASE_URL=postgresql+psycopg://nexora_owner:CHANGE_ME@localhost:5432/nexora
NEXORA_ENVIRONMENT=production
NEXORA_COOKIE_SECURE=true
NEXORA_ALLOWED_ORIGINS=["https://app.example.com"]
NEXORA_PUBLIC_BASE_URL=https://app.example.com
