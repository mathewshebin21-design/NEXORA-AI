# Runtime role: must NOT have BYPASSRLS
NEXORA_DATABASE_URL=postgresql+psycopg://nexora_app:CHANGE_ME@localhost:5432/nexora
# Owner role: runs migrations only
NEXORA_OWNER_DATABASE_URL=postgresql+psycopg://nexora_owner:CHANGE_ME@localhost:5432/nexora
NEXORA_ENVIRONMENT=production
NEXORA_COOKIE_SECURE=true
NEXORA_ALLOWED_ORIGINS=["https://app.example.com"]
NEXORA_PUBLIC_BASE_URL=https://app.example.com

# ---- Connectors (Phase 3) ----
# Required for live connections (encrypts OAuth tokens at rest):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NEXORA_ENCRYPTION_KEY=
# Production: run `python -m nexora.worker` separately and leave this false
NEXORA_EMBEDDED_WORKER=false
NEXORA_GOOGLE_CLIENT_ID=
NEXORA_GOOGLE_CLIENT_SECRET=
NEXORA_GOOGLE_ADS_DEVELOPER_TOKEN=
NEXORA_GOOGLE_ADS_LOGIN_CUSTOMER_ID=
NEXORA_META_APP_ID=
NEXORA_META_APP_SECRET=
NEXORA_SHOPIFY_CLIENT_ID=
NEXORA_SHOPIFY_CLIENT_SECRET=
# API versions (confirm current versions before go-live)
NEXORA_GOOGLE_ADS_API_VERSION=v26
NEXORA_META_API_VERSION=v25.0
NEXORA_SHOPIFY_API_VERSION=2026-10
